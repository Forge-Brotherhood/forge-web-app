#
# Forge Web App (Next.js) environment variables
#
# Copy to `.env` for local development:
#   cp env.example .env
#

# Required for Prisma (Postgres)
DATABASE_URL="postgresql://dev:dev@localhost:5432/forge?schema=public"

# Optional (only needed for `prisma migrate dev` / migration creation workflows)
# Must point to a DIFFERENT database than DATABASE_URL.
SHADOW_DATABASE_URL="postgresql://dev:dev@localhost:5432/forge_shadow?schema=public"

# Vercel: run Prisma migrations during `vercel-build` when explicitly enabled.
RUN_PRISMA_MIGRATIONS="false"

# Bible API Provider
# Provider selection: 'aolab' (default) or 'apibible'
# - aolab: Free, has BSB. No API key required.
# - apibible: Has NLT (premium). Requires API_BIBLE_KEY.
BIBLE_API_PROVIDER="aolab"

# Required for api.bible provider (get key from https://scripture.api.bible/)
# Note: BSB not available on api.bible (falls back to NLT)
# API_BIBLE_KEY="your_api_key_here"


# Server heartbeat (Phase 4). Nothing runs unless HEARTBEAT_ENABLED is "true". Off by default.
HEARTBEAT_ENABLED="false"
# AWS KMS key that wraps each user's brief key (key id, or an alias ARN), and the dedicated IAM identity
# that may only kms:Encrypt and kms:Decrypt with it, and only when the encryption context has `userId`.
# HEARTBEAT_KMS_KEY_ID="..."
# HEARTBEAT_AWS_REGION="us-east-1"
# HEARTBEAT_AWS_ACCESS_KEY_ID="..."
# HEARTBEAT_AWS_SECRET_ACCESS_KEY="..."
# Vercel sends this as `Authorization: Bearer <secret>` on cron requests. Required for /api/cron/*.
# CRON_SECRET="a long random string"
